{
  "$schema": "https://turborepo.dev/schema.json",
  "futureFlags": {
    "experimentalCargoWorkspaces": true,
    "experimentalTaskCommand": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "check": {
      "dependsOn": ["^check"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "format": {
      "cache": false
    },
    "format:check": {},
    "//#format:check": {},
    "dev": {
      "persistent": true,
      "cache": false
    },
    "frontier-lexicon-rust#lint": {
      "command": ["cargo", "lint"]
    },
    "web#generate": {
      "inputs": [
        "content-collections.ts",
        "lib/**",
        "$TURBO_ROOT$/content/concepts/**"
      ],
      "outputs": [".content-collections/**", "public/concepts/**"]
    },
    "web#build": {
      "dependsOn": ["^build", "check"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/content/concepts/**"],
      "outputs": ["out/**"]
    },
    "web#check": {
      "dependsOn": ["generate"]
    }
  }
}
