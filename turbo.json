{
  "$schema": "https://turborepo.dev/schema.json",
  "futureFlags": {
    "experimentalCargoWorkspaces": true,
    "experimentalTaskCommand": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "check": {
      "dependsOn": ["^check"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "format": {
      "cache": false
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "frontier-lexicon-rust#lint": {
      "command": ["cargo", "clippy", "--workspace", "--locked", "--", "-D", "warnings"]
    }
  }
}
