{
  "$schema": "https://turborepo.dev/schema.json",
  "globalPassThroughEnv": ["ENABLE_EXPERIMENTAL_COREPACK"],
  "futureFlags": {
    "experimentalCargoWorkspaces": true,
    "experimentalTaskCommand": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "check": {
      "dependsOn": ["^check"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "format": {
      "cache": false
    },
    "format:check": {},
    "//#format:check": {},
    "dev": {
      "persistent": true,
      "cache": false
    },
    "frontier-lexicon-rust#lint": {
      "command": ["cargo", "lint"]
    },
    "frontier-lexicon-rust#validate": {
      "command": [
        "cargo",
        "run",
        "-p",
        "lexicon",
        "--locked",
        "--",
        "validate"
      ],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/content/concepts/**"]
    },
    "frontier-lexicon-rust#graph": {
      "command": ["cargo", "run", "-p", "lexicon", "--locked", "--", "build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/content/concepts/**"],
      "cache": false
    },
    "web#generate": {
      "inputs": [
        "content-collections.ts",
        "lib/**",
        "$TURBO_ROOT$/content/concepts/**"
      ],
      "outputs": [".content-collections/**", "public/concepts/**"]
    },
    "web#build": {
      "dependsOn": ["^build", "check"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/content/concepts/**",
        "$TURBO_ROOT$/content/graph.json"
      ],
      "outputs": ["out/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "web#check": {
      "dependsOn": ["generate"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/content/graph.json"]
    },
    "web#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/content/graph.json"]
    }
  }
}
